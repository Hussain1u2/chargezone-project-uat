{
  "rewrites": [
    {
      "source": "/.env",
      "destination": "/.env"
    },
    {
      "source": "/js/:path*",
      "destination": "/js/:path*"
    },
    {
      "source": "/css/:path*",
      "destination": "/css/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/((?!.env|js/|css/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
