# Application Server Port
PORT=4000

# JSON Web Token Secret (Required for production - use a strong 64+ char random string)
JWT_SECRET=your_secure_jwt_secret_key_here

# PostgreSQL Database Credentials
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=Your_db_pass
DB_NAME=db-name

# Configurable Rate Limiting Thresholds (in milliseconds and request counts)
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=15
RATE_LIMIT_AUTH_ACCOUNT_MAX=5
RATE_LIMIT_PUBLIC_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX=300
RATE_LIMIT_AUTHENTICATED_WINDOW_MS=900000
RATE_LIMIT_AUTHENTICATED_MAX=1500
RATE_LIMIT_EXPONENTIAL_BASE_MS=1000
RATE_LIMIT_EXPONENTIAL_MAX_DELAY_MS=30000